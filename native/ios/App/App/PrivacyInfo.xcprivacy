<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Do. does not track anybody, and contacts no tracking domain. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  Nothing is collected. Sync has no account: a device encrypts its lists
	  with a key that stays on the person's devices, and the server keeps
	  only that encrypted copy under a random id. It cannot be read by the
	  developer, which is Apple's test for "collected". No email address, no
	  name, no identifier, no usage data.
	  This has to say the same thing as the App Privacy answers in
	  App Store Connect; if one changes, change the other.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!--
	  UserDefaults is a "required reason" API. Two honest reasons:
	  CA92.1 - the app reads back settings it wrote itself (the Preferences
	           plugin keeps them there);
	  1C8F.1 - the app writes the day's tasks into its App Group so that its
	           own widget can show them.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
