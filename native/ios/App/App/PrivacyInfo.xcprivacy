<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Do. does not track anybody, and contacts no tracking domain. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  One thing is collected, and only from people who choose it: a founding
	  seat or an invitation. The server keeps a seat number, an invitation
	  code and the SHA-256 of a random key made on the device. Apple's word
	  for that is a User ID. It is not linked to a name or an email (there are
	  none) and it is not used for tracking.
	  Lists are not collected. Sync has no account: a device encrypts its
	  lists with a key that stays on the person's devices, and the server
	  keeps only that encrypted copy, which the developer cannot read.
	  This has to say the same thing as the App Privacy answers in
	  App Store Connect; if one changes, change the other.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!--
	  UserDefaults is a "required reason" API. Two honest reasons:
	  CA92.1 - the app reads back settings it wrote itself (the Preferences
	           plugin keeps them there);
	  1C8F.1 - the app writes the day's tasks into its App Group so that its
	           own widget can show them.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
